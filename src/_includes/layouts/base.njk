<!DOCTYPE html>
<html lang="fil">
<head>
    <meta charset="UTF-8">
    <meta name="google-site-verification" content="HtvH3JsGA5E_Ks8rlIga8kdOM67AjvlGiPKa6wxHdKQ" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title if title else "Pilipinas Auto News Portal" }}</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            background-color: #f4f6f9;
            font-family: 'Helvetica Neue', Arial, sans-serif;
        }
        header {
            background-color: #00467f;
            color: white;
            padding: 20px;
            text-align: center;
        }
        header h1 {
            margin: 0;
            font-size: 2em;
            font-weight: 900;
        }
        header nav {
            margin-top: 8px;
        }
        header nav a {
            color: #cbd5e1;
            text-decoration: none;
            font-weight: bold;
        }
        main {
            max-width: 800px;
            margin: 30px auto;
            padding: 0 20px;
        }
        main h1 { color: #1e293b; margin-bottom: 20px; }
        main ul { list-style: none; padding: 0; }
        main li { 
            padding: 15px 0; 
            border-bottom: 1px solid #ddd; 
        }
        main li a { 
            color: #00467f; 
            text-decoration: none; 
            font-weight: bold;
            font-size: 1.1em;
        }
        main li a:hover { text-decoration: underline; }
        main small { color: #64748b; }
        footer {
            text-align: center;
            padding: 25px;
            background: #1e293b;
            color: #94a3b8;
            margin-top: 50px;
        }
    </style>
</head>
<body>
    <header>
        <h1>Pilipinas Auto News Portal</h1>
        <nav>
            <a href="/">Home (Balita)</a>
        </nav>
    </header>
    
    <main>
        {{ content | safe }}
    </main>

    <footer>
        <p>&copy; 2026 Auto News Aggregator.</p>
    </footer>
</body>
</html>
